<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="eapstudio.exe"
        Arguments=""
        InstallLocation="C:\Program Files\EapStudio\EapStudio">
    </Installer>
    <PackageInformation
        PackageName="EapStudio"
        PackageDisplayName="EapStudio"
        PublisherName="CN=EapStudio"
        PublisherDisplayName="EapStudio"
        Version="0.1.0.0"
        PackageDescription="AI-powered SECS/GEM Equipment Integration Studio">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.eapstudio.desktop"
                Description="AI-powered SECS/GEM Equipment Integration Studio"
                DisplayName="EapStudio"
                ExecutableName="eapstudio.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>EapStudio</DisplayName>
            <PublisherDisplayName>EapStudio</PublisherDisplayName>
            <Description>AI-powered SECS/GEM Equipment Integration Studio</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="eapstudio.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
